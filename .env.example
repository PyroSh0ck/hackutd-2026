DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
LOG_LEVEL=info
DEMO_USER_EMAIL=""
# Scamper opponent model (server-only; never NEXT_PUBLIC_). OpenAI-compatible chat completions with tools.
# Example for NVIDIA-hosted Nemotron: MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=
# Optional: separate HMAC secret for the anonymous player cookie (defaults to BETTER_AUTH_SECRET).
GAME_COOKIE_SECRET=
# Observer (optional; reuses MODEL_BASE_URL/MODEL_API_KEY). Defaults: MODEL_ID for both models, forced
# tool-call structured output, review of every acceptance/refusal plus flagged cases, 15 s per call.
OBSERVER_MODEL_ID=
OBSERVER_REVIEWER_MODEL_ID=
# tool | json_schema
OBSERVER_STRUCTURED_MODE=tool
# consequential_and_flagged | flagged_only (an invalid value is an error, never silently defaulted)
OBSERVER_REVIEW_POLICY=consequential_and_flagged
OBSERVER_TIMEOUT_MS=15000
# Planner/actor (optional; default to MODEL_ID). 20 s per call, no retries.
PLANNER_MODEL_ID=
ACTOR_MODEL_ID=
PLANNER_TIMEOUT_MS=20000

# Training authority. "spacetime" makes the SpacetimeDB module (spacetime/) the single authority for
# training state; unset uses Postgres. Credentials: pnpm spacetime:setup writes .spacetime/worker.json
# (gitignored), or set all three below. The worker token is server-side only.
TRAINING_BACKEND=
SPACETIME_URL=
SPACETIME_DATABASE=
SPACETIME_TOKEN=
# "tools": the planner runs as a function-calling agent (get_training_context / execute_training_move).
PLANNER_PROTOCOL=
