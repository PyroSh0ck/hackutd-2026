// Observer subsystem persistence (docs/agents/observer_agent). Append-only history; views are derived.
// `revision` on child rows is the session revision that created them: one explicit total order.

model ObserverSession {
  id                   String    @id @db.Uuid
  /// Anonymous player id from the signed `scamper_player` cookie. Never sent to clients.
  ownerKey             String
  threadId             String    @unique @db.Uuid
  /// Scenario identity (planner brief §3). Pre-planner rows are the legacy observer scenario.
  scenarioId           String    @default("legacy-observer-v1")
  scenarioVersion      Int       @default(0)
  revision             Int
  conversationRevision Int
  turn                 Int
  ended                Boolean   @default(false)
  /// Current view of the session lifecycle: active | verifying | awaiting_final_decision | ended.
  stage                String    @default("active")
  /// First terminal outcome wins; never overwritten.
  outcome              String?
  /// Server-generated FICTIONAL practice code. Never sent to planner/actor models.
  practiceCode         String?
  /// Reserved fictional case reference (CD-######), introduced only by a committed message.
  caseReference        String?
  /// Durable, leased processing claim (one processor per session across instances).
  claimId              String?
  claimExpiresAt       DateTime?
  createdAt            DateTime
  updatedAt            DateTime  @updatedAt

  messages    ObserverMessage[]
  requests    ObserverRequest[]
  events      ObserverEvent[]
  receipts    ObserverReceipt[]
  assessments ObserverAssessment[]
  issues      ObserverIssue[]
  additions   ObserverAddition[]
  plans       PlannerRecord[]

  @@index([ownerKey])
  @@map("observer_session")
}

model ObserverMessage {
  id        String          @id
  sessionId String          @db.Uuid
  revision  Int
  turn      Int
  role      String
  content   String
  createdAt DateTime
  session   ObserverSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, revision])
  @@map("observer_message")
}

model ObserverRequest {
  id                    String          @id
  sessionId             String          @db.Uuid
  revision              Int
  introducedByMessageId String
  targetAction          String
  description           String
  status                String
  /// Insertion order: several requests can share one revision (one message introducing many).
  seq                   Int             @default(autoincrement())
  session               ObserverSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, revision])
  @@map("observer_request")
}

/// Trusted application events. No submitted codes or account contents are stored.
model ObserverEvent {
  id          String          @id
  sessionId   String          @db.Uuid
  revision    Int
  requestId   String?
  turn        Int
  type        String
  /// Server-issued id linking the verification launch to its completion.
  challengeId String?
  /// Server-only detail (verification result code, stop source, audit target). Never sent to models.
  detail      String?
  /// Insertion order: one commit can write several events at the same revision.
  seq         Int             @default(autoincrement())
  createdAt   DateTime
  session     ObserverSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, revision])
  @@map("observer_event")
}

/// Idempotency receipts for client submissions (messages and events).
model ObserverReceipt {
  sessionId   String          @db.Uuid
  key         String
  kind        String
  payloadHash String
  resultId    String
  challengeId String?
  createdAt   DateTime        @default(now())
  session     ObserverSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, key])
  @@map("observer_receipt")
}

/// One row per pipeline run. `appliedKey` is set only for applied records, so the unique index allows
/// many stale (audit) rows but at most one applied interpretation per (request, message) pair.
model ObserverAssessment {
  id               String          @id
  sessionId        String          @db.Uuid
  /// Null for a conversation-scope assessment (no request presented yet).
  requestId        String?
  currentMessageId String
  basedOnRevision  Int
  application      String
  appliedKey       String?         @unique
  seq              Int             @default(autoincrement())
  record           Json
  createdAt        DateTime
  session          ObserverSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, seq])
  @@map("observer_assessment")
}

/// Server-owned issue lifecycle (addendum §4). Created only from applied accepted/corrected assessments.
model ObserverIssue {
  id                     String          @id
  sessionId              String          @db.Uuid
  requestId              String?
  kind                   String
  summary                String
  evidence               Json
  status                 String
  originAssessmentId     String
  addressedMessageId     String?
  resolvedByAssessmentId String?
  resolutionEventId      String?
  /// assessment id + kind + ordered evidence: exact replay deduplication.
  dedupeKey              String          @unique
  seq                    Int             @default(autoincrement())
  session                ObserverSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, seq])
  @@map("observer_issue")
}

/// Reserved bounded additions (planner brief §3). `introducedMessageId` is set only by a committed message.
model ObserverAddition {
  sessionId           String          @db.Uuid
  additionId          String
  text                String
  introducedMessageId String?
  session             ObserverSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, additionId])
  @@map("observer_addition")
}

/// Planner/actor attempts (planner brief §7, §10). `committedKey` allows at most one committed response
/// per input event; prepared/failed/stale rows keep it null.
model PlannerRecord {
  id           String          @id
  sessionId    String          @db.Uuid
  inputId      String
  attempt      Int
  status       String
  committedKey String?         @unique
  seq          Int             @default(autoincrement())
  record       Json
  createdAt    DateTime
  session      ObserverSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, seq])
  @@map("planner_record")
}
