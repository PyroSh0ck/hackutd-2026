{
  "name": "claude-configuration-testing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "playwright test tests/api",
    "test:e2e": "playwright test tests/e2e",
    "test:integration": "playwright test",
    "test:report": "playwright show-report",
    "db:seed": "prisma db seed",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:test": "prisma migrate deploy --config prisma.test.config.ts",
    "gen": "tsx generator/cli.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm test:integration",
    "game:smoke": "tsx --conditions=react-server scripts/game-smoke.ts",
    "observer:eval": "tsx --conditions=react-server scripts/observer-eval.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.15",
    "@hookform/resolvers": "^7.0.1",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.15",
    "dotenv": "^18.0.9",
    "lucide-react": "1.67.0",
    "next": "16.4.4",
    "pino": "^10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
